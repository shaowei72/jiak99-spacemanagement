{
  "_about": "Enquiries to run against week.json, each with the answer we expect. Run: uv run scenarios",
  "days": "week.json",
  "today": "2026-12-01",
  "scenarios": [
    {"id": "S01", "title": "Spare seats in a taken zone aren't sold: the group gets its own zone",
     "enquiry": {"date": "2026-12-01", "start": "12:00", "type": "PREMIUM", "adults": 11},
     "expect": {"verdict": "ACCEPT_GOOD", "placement": "new"}},

    {"id": "S02", "title": "Group of 30 takes exactly the last two free zones at 12:00",
     "enquiry": {"date": "2026-12-01", "start": "12:00", "type": "PREMIUM", "adults": 30},
     "expect": {"verdict": "ACCEPT_GOOD", "placement": "split", "reason_contains": "needs 2 zones (25 + 5)"}},

    {"id": "S03", "title": "10:00 start leaves 09:00-10:00 unsellable; 10:30 same day is better",
     "enquiry": {"date": "2026-12-01", "start": "10:00", "type": "PREMIUM", "adults": 10},
     "expect": {"verdict": "ACCEPT_COSTLY", "reason_contains": "09:00–10:00", "first_alternative": "2026-12-01 10:30 PREMIUM"}},

    {"id": "S04", "title": "Small-group warning (warn below 6)",
     "settings": {"warn_below": 6},
     "enquiry": {"date": "2026-12-01", "start": "15:00", "type": "CLASSIC_CT", "adults": 4},
     "expect": {"verdict": "ACCEPT_COSTLY", "reason_contains": "only 4 people"}},

    {"id": "S05", "title": "Ends after closing time",
