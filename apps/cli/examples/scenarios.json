     "expect": {"verdict": "ACCEPT_COSTLY", "placement": "split", "reason_contains": "12:00–13:00", "first_alternative": "2026-12-06 13:30 PREMIUM"}},

    {"id": "S24", "title": "Blackout: request runs into the private event",
     "enquiry": {"date": "2026-12-07", "start": "13:00", "type": "PREMIUM", "adults": 10},
     "expect": {"verdict": "NOT_POSSIBLE", "reason_contains": "14:00–17:00 blackout", "first_alternative": "2026-12-07 12:00 PREMIUM"}},

    {"id": "S25", "title": "Blackout: request right after the private event",
     "enquiry": {"date": "2026-12-07", "start": "17:00", "type": "CLASSIC_CT", "adults": 6},
     "expect": {"verdict": "ACCEPT_GOOD", "placement": "new"}},

    {"id": "S26", "title": "Closed day: next open day offered",
     "enquiry": {"date": "2026-12-08", "start": "12:00", "type": "PREMIUM", "adults": 10},
     "expect": {"verdict": "NOT_POSSIBLE", "reason_contains": "closed", "first_alternative": "2026-12-09 12:00 PREMIUM"}},

    {"id": "S27", "title": "Group of 60 needs 3 zones at 12:00, only 2 free",
     "enquiry": {"date": "2026-12-01", "start": "12:00", "type": "PREMIUM", "adults": 60},
     "expect": {"verdict": "NOT_POSSIBLE", "reason_contains": "Only 2 zones free at 12:00; this group needs 3"}},

    {"id": "S28", "title": "Upgrade offered: 19:00 Premium fills the evening that Classic leaves half-used",
     "enquiry": {"date": "2026-12-01", "start": "19:00", "type": "CLASSIC", "adults": 8},
     "expect": {"verdict": "ACCEPT_COSTLY", "reason_contains": "20:30–21:00", "options_include": ["2026-12-01 19:00 PREMIUM"]}},

    {"id": "S29", "title": "Never a downgrade: Premium would fit perfectly but drops the Chef's Table",
     "enquiry": {"date": "2026-12-01", "start": "19:00", "type": "CLASSIC_CT", "adults": 8},
     "expect": {"verdict": "ACCEPT_COSTLY", "first_alternative": "2026-12-01 19:30 CLASSIC_CT", "options_exclude": ["2026-12-01 19:00 PREMIUM"]}}
  ]
