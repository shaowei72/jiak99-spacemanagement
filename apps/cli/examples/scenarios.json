     "expect": {"verdict": "ACCEPT_COSTLY", "placement": "new", "reason_contains": "09:00–10:00", "first_alternative": "2026-12-06 10:30 PREMIUM"}},

    {"id": "S21", "title": "Big groups: 26 people need 2 zones at 10:00, only 1 free",
     "enquiry": {"date": "2026-12-06", "start": "10:00", "type": "PREMIUM", "adults": 26},
