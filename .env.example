# Copy to .env and change what you need. .env is never committed (see .gitignore).
# `docker compose` reads .env automatically. Every value below has a default in docker-compose.yml.

# --- PostgreSQL (the "db" container) -------------------------------------------------------
# Letters and digits only in the password: it is put into a database URL.
POSTGRES_USER=jiak
POSTGRES_PASSWORD=jiak
POSTGRES_DB=jiak
# Port on this computer. Change it if another PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# --- api ------------------------------------------------------------------------------------
# Port on this computer: http://127.0.0.1:8000/docs
API_PORT=8000
# fake = in-memory Outlook stand-in. Never set "real" until Milestone 4 and the admin steps in README.md.
GRAPH_MODE=fake

# Inside Docker the api's DATABASE_URL is built from the POSTGRES_* values above. Outside Docker
# (`uv run ...` in PowerShell) the default is the SQLite file jiak99-dev.db; to use the Docker
# PostgreSQL instead, set in PowerShell:
#   $env:DATABASE_URL = "postgresql+psycopg://jiak:jiak@127.0.0.1:5432/jiak"
# and for running the tests on PostgreSQL (uses the separate jiak_test database):
#   $env:TEST_DATABASE_URL = "postgresql+psycopg://jiak:jiak@127.0.0.1:5432/jiak_test"

# --- Microsoft Graph (Milestone 4, only with GRAPH_MODE=real) ------------------------------
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# BOOKINGS_MAILBOX=
# ZONE_A_MAILBOX=
# ZONE_B_MAILBOX=
# ZONE_C_MAILBOX=
# ZONE_D_MAILBOX=
