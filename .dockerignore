# Files Docker never copies into the image (keeps builds small and secrets out).
.git
.venv
.env
.env.*
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.coverage
htmlcov
*.db
*.log
# Calendar files and review sheets hold customer data: never in the image.
*.ics
*-review.csv
